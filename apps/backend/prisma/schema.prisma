// Prisma configuration for TodoPollo y Más
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUM: Tipos de Hamburguesa
// -------------------------------------------------------------
enum TipoHamburguesa {
  JAMON_QUESO
  ESPINACA_QUESO
  ZANAHORIA_QUESO
}

// -------------------------------------------------------------
// 1. PRODUCCIÓN: Registro de Cajones de pechugas
// -------------------------------------------------------------
model Cajon {
  id               String   @id @default(uuid())
  fecha            DateTime @default(now())
  costoTotal       Float    @map("costo_total")
  unidadesRendidas Int?     @map("unidades_rendidas")
  proveedor        String?
  notas            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relación con los movimientos de stock que generó este cajón
  movimientos      MovimientoStock[]

  // Distribución de unidades por tipo de hamburguesa
  rendimientoPorTipo CajonRendimientoPorTipo[]

  @@map("cajones")
}

/// Distribución de hamburguesas rendidas por tipo para cada cajón
model CajonRendimientoPorTipo {
  id       String          @id @default(uuid())
  cajonId  String          @map("cajon_id")
  cajon    Cajon           @relation(fields: [cajonId], references: [id], onDelete: Cascade)
  tipo     TipoHamburguesa
  cantidad Int             @default(0)

  @@unique([cajonId, tipo])
  @@map("cajon_rendimiento_por_tipo")
}

// -------------------------------------------------------------
// 2. STOCK: Inventario Central
// -------------------------------------------------------------
model Stock {
  id             String   @id @default(uuid())
  cantidadActual Int      @default(0) @map("cantidad_actual")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("stock")
}

/// Stock desglosado por tipo de hamburguesa (una fila por tipo)
model StockPorTipo {
  id             String          @id @default(uuid())
  tipo           TipoHamburguesa @unique
  cantidadActual Int             @default(0) @map("cantidad_actual")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("stock_por_tipo")
}

enum TipoMovimientoStock {
  INGRESO_PRODUCCION
  EGRESO_PEDIDO
  AJUSTE_MANUAL
}

model MovimientoStock {
  id               String              @id @default(uuid())
  fecha            DateTime            @default(now())
  tipo             TipoMovimientoStock
  cantidad         Int                 // Positivo para ingresos, negativo para egresos
  balancePosterior Int                 @map("balance_posterior")
  motivo           String?
  
  cajonId          String?             @map("cajon_id")
  cajon            Cajon?              @relation(fields: [cajonId], references: [id], onDelete: SetNull)

  pedidoId         String?             @map("pedido_id")
  pedido           Pedido?             @relation(fields: [pedidoId], references: [id], onDelete: SetNull)

  createdAt        DateTime            @default(now()) @map("created_at")

  @@map("movimientos_stock")
}

// -------------------------------------------------------------
// 3. PEDIDOS: Registro de Ventas
// -------------------------------------------------------------
enum EstadoPedido {
  PENDIENTE
  EN_PREPARACION
  ENTREGADO
  CANCELADO
}

model Pedido {
  id                   String            @id @default(uuid())
  clienteNombre        String            @map("cliente_nombre")
  cantidadHamburguesas Int               @map("cantidad_hamburguesas") // Suma total de items
  precioTotal          Float             @map("precio_total")
  estado               EstadoPedido      @default(PENDIENTE)
  fechaPedido          DateTime          @default(now()) @map("fecha_pedido")
  fechaEntrega         DateTime?         @map("fecha_entrega")
  notas                String?
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  movimientos          MovimientoStock[]
  items                ItemPedido[]

  @@map("pedidos")
}

/// Ítems de un pedido: cuántas hamburguesas de cada tipo
model ItemPedido {
  id       String          @id @default(uuid())
  pedidoId String          @map("pedido_id")
  pedido   Pedido          @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  tipo     TipoHamburguesa
  cantidad Int

  @@unique([pedidoId, tipo])
  @@map("items_pedido")
}

// -------------------------------------------------------------
// 4. GASTOS: Registro de Costos Extra e Insumos
// -------------------------------------------------------------
enum CategoriaGasto {
  SEPARADORES_BOLSAS
  CONDIMENTOS_INSUMOS
  SERVICIOS_LUZ_GAS
  ENVIO_LOGISTICA
  OTROS
}

model Gasto {
  id        String          @id @default(uuid())
  fecha     DateTime        @default(now())
  concepto  String
  categoria CategoriaGasto  @default(OTROS)
  monto     Float
  notas     String?
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@map("gastos")
}
